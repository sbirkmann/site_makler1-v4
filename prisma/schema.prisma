generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MarketingType {
  KAUF
  MIETE
}

enum PropertyType {
  HAUS
  WOHNUNG
  MEHRFAMILIENHAUS
  GRUNDSTUECK
  GEWERBE
}

enum PropertyStatus {
  VERFUEGBAR
  RESERVIERT
  VERKAUFT
  VERMIETET
  IN_VORBEREITUNG
}

enum EnergyCertificateType {
  VERBRAUCHSAUSWEIS
  BEDARFSAUSWEIS
  NICHT_ERFORDERLICH
}

enum EnergyEfficiencyClass {
  A_PLUS
  A
  B
  C
  D
  E
  F
  G
  H
}

enum HeatingType {
  GAS
  OEL
  FERNWAERME
  WAERMEPUMPE
  PELLET
  SOLAR
  BLOCKHEIZKRAFTWERK
  ELEKTRO
}

enum PropertyCondition {
  NEUWERTIG
  SANIERT
  GEPFLEGT
  RENOVIERUNGSBEDUERFTIG
  ABRISSOBJEKT
}

enum SellingIntent {
  BALD_VERKAUFEN
  INFORMIEREN
  PROFESSIONELLE_BEWERTUNG
  KONKRETES_OBJEKT
}

enum RequestStatus {
  NEU
  IN_BEARBEITUNG
  KONTAKTIERT
  ABGESCHLOSSEN
}

enum LeadSource {
  OBJEKTANFRAGE
  VERKAUFSFUNNEL
  BEWERTUNGSFUNNEL
  KONTAKTFORMULAR
  SUCHPROFIL
}

// ---------------------------------------------------------------------------
// Immobilien
// ---------------------------------------------------------------------------

model Property {
  id               String @id @default(cuid())
  slug             String @unique
  title            String
  shortDescription String
  description      String @db.Text

  marketingType MarketingType
  propertyType  PropertyType
  status        PropertyStatus @default(VERFUEGBAR)

  price          Decimal? @db.Decimal(12, 2)
  currency       String   @default("EUR")
  priceOnRequest Boolean  @default(false)
  // Bei Mietobjekten: Nebenkosten / Kaution optional
  serviceCharge  Decimal? @db.Decimal(10, 2)

  livingArea Float?
  plotArea   Float?
  usableArea Float?
  rooms      Float?
  bedrooms   Int?
  bathrooms  Int?
  yearBuilt  Int?
  condition  PropertyCondition?

  energyCertificateType EnergyCertificateType?
  energyEfficiencyClass EnergyEfficiencyClass?
  energyConsumption     Float?
  heatingType           HeatingType?

  street    String?
  zipCode   String
  city      String
  region    String?
  country   String  @default("Deutschland")
  latitude  Float?
  longitude Float?

  // Freitext-Listen
  highlights          String[] @default([])
  features            String[] @default([])
  locationDescription String?  @db.Text

  featured     Boolean   @default(false)
  publishedAt  DateTime?
  // Kennzeichnet automatisiert aus einem OpenImmo-Export übernommene Objekte.
  importSource String?
  externalId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  images    PropertyImage[]
  documents PropertyDocument[]
  leads     Lead[]

  @@unique([importSource, externalId])
  @@index([marketingType, propertyType])
  @@index([city])
  @@index([featured])
  @@index([publishedAt])
}

// ---------------------------------------------------------------------------
// OpenImmo-FTP / CRM-Weiterleitung
// ---------------------------------------------------------------------------

model FtpAccount {
  id        String   @id @default(cuid())
  username  String   @unique
  // Das Kennwort liegt ausschließlich gehasht im SFTPGo-Datenprovider.
  homeDir   String   @default("/imports")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OpenImmoImport {
  id            String   @id @default(cuid())
  fileName      String
  checksum      String   @unique
  status        String   @default("PROCESSED") // PROCESSED | FAILED | DUPLICATE
  propertyCount Int      @default(0)
  error         String?  @db.Text
  processedAt   DateTime @default(now())
}

model LeadPushProvider {
  id        String   @id @default(cuid())
  provider  String   @unique // ONOFFICE | PROPSTACK | FLOWFACT
  enabled   Boolean  @default(false)
  endpoint  String?
  apiKey    String?
  updatedAt DateTime @updatedAt
}

model BlogApiSettings {
  id                   String   @id @default("default")
  enabled              Boolean  @default(false)
  allowUnauthenticated Boolean  @default(false)
  apiKey               String?
  updatedAt            DateTime @updatedAt
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  alt        String
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([propertyId, sortOrder])
}

model PropertyDocument {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title      String
  url        String
  kind       String   @default("EXPOSE") // EXPOSE | GRUNDRISS | ENERGIEAUSWEIS
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// Team
// ---------------------------------------------------------------------------

model Agent {
  id        String   @id @default(cuid())
  slug      String   @unique
  firstName String
  lastName  String
  role      String
  email     String
  phone     String?
  imageUrl  String?
  bio       String?  @db.Text
  focus     String[] @default([])
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties    Property[]
  leads         Lead[]
  blogPosts     BlogPost[]    @relation("BlogAuthor")
  savedSearches SavedSearch[]
}

// ---------------------------------------------------------------------------
// Anfragen
// ---------------------------------------------------------------------------

model Lead {
  id     String        @id @default(cuid())
  source LeadSource
  status RequestStatus @default(NEU)

  firstName String?
  lastName  String
  email     String
  phone     String?
  message   String? @db.Text

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  privacyAccepted Boolean @default(false)
  internalNote    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([source])
}

model ValuationRequest {
  id     String        @id @default(cuid())
  status RequestStatus @default(NEU)
  // BEWERTUNG (Immobilienbewertung) oder VERKAUF (Verkaufsfunnel)
  funnel String        @default("BEWERTUNG")

  propertyType PropertyType
  street       String?
  zipCode      String
  city         String

  livingArea Float?
  plotArea   Float?
  rooms      Float?
  yearBuilt  Int?
  condition  PropertyCondition?

  sellingIntent SellingIntent?

  firstName String
  lastName  String
  email     String
  phone     String?
  message   String? @db.Text

  privacyAccepted Boolean @default(false)

  // Ergebnis einer (spaeteren) externen Bewertungs-API
  estimatedValueMin Decimal? @db.Decimal(12, 2)
  estimatedValueMax Decimal? @db.Decimal(12, 2)
  valuationProvider String?

  internalNote String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model ContactRequest {
  id      String        @id @default(cuid())
  status  RequestStatus @default(NEU)
  subject String?

  firstName String?
  lastName  String
  email     String
  phone     String?
  message   String  @db.Text

  privacyAccepted Boolean @default(false)
  internalNote    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Bewertungen / Content
// ---------------------------------------------------------------------------

model Review {
  id           String        @id @default(cuid())
  authorName   String
  initials     String
  rating       Int
  title        String?
  body         String        @db.Text
  city         String?
  propertyType PropertyType?
  serviceType  String? // Verkauf | Kauf | Vermietung | Bewertung
  published    Boolean       @default(true)
  isDemo       Boolean       @default(true)
  reviewedAt   DateTime
  createdAt    DateTime      @default(now())

  @@index([published, reviewedAt])
}

model BlogCategory {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  posts       BlogPost[]
}

model BlogPost {
  id             String  @id @default(cuid())
  slug           String  @unique
  title          String
  excerpt        String
  content        String  @db.Text
  coverImage     String?
  readingMinutes Int     @default(5)

  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  authorId String?
  author   Agent?  @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  seoTitle       String?
  seoDescription String?

  published   Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

/**
 * Suchprofil aus dem Kontakt-Funnel: Was sucht der Interessent, in welchem
 * Rahmen, und wie ist er erreichbar. `query` haelt zusaetzlich die rohen
 * Kriterien fuer einen spaeteren automatischen Abgleich mit neuen Objekten.
 */
model SavedSearch {
  id     String        @id @default(cuid())
  status RequestStatus @default(NEU)

  label String
  query Json

  // Gesuchte Immobilie
  marketingType MarketingType  @default(KAUF)
  propertyTypes PropertyType[] @default([])

  regions  String[] @default([])
  zipCode  String?
  radiusKm Int?

  priceMin    Decimal? @db.Decimal(12, 2)
  priceMax    Decimal? @db.Decimal(12, 2)
  roomsMin    Float?
  areaMin     Float?
  plotAreaMin Float?

  // Zeitlicher Rahmen und Finanzierung – fuer die Priorisierung im Vertrieb
  timeframe String?
  financing String?
  ownUse    Boolean @default(true)

  // Kontakt
  firstName String?
  lastName  String
  email     String
  phone     String?
  message   String? @db.Text

  privacyAccepted Boolean @default(false)
  notifyByEmail   Boolean @default(true)
  internalNote    String? @db.Text

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status, createdAt])
}

/**
 * Im Verwaltungsbereich pflegbare Öffnungszeiten. Ein Datensatz pro Zeile
 * der Anzeige; `sortOrder` bestimmt die Reihenfolge. Bleibt die Tabelle
 * leer, greift die Vorgabe aus `lib/site.ts`.
 */
model OpeningHour {
  id        String  @id @default(cuid())
  days      String
  hours     String
  closed    Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}
